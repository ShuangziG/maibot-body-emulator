{
  "manifest_version": 2,
  "id": "maibot-body-emulator",
  "name": "麦麦身体",
  "version": "1.1.0",
  "description": "让麦麦有一副真实运转的身体：心血管、呼吸、代谢、肾脏、内分泌、体温与消化道连续仿真，可在 WebUI 里查看体征曲线、内脏细则与进食记录",
  "author": {
    "name": "Evil双子",
    "url": "https://github.com/ShuangziG"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "capabilities": [
    "send.text",
    "send.image",
    "render.html2png",
    "api.call",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "maibody.png",
      "fallback": "heart-pulse",
      "background": "#F9D5E5"
    }
  },
  "urls": {
    "repository": "https://github.com/ShuangziG/maibot-body-emulator",
    "homepage": "https://github.com/ShuangziG/maibot-body-emulator",
    "documentation": "https://github.com/ShuangziG/maibot-body-emulator/blob/main/README.md"
  }
}
